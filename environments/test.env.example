APP_ENV=test
FLASK_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=change-me-test
DATABASE_URL=mysql+pymysql://user:password@db-host:3306/jigsaurium_test
CANONICAL_HOST=www.test.jigsaurium.lateral-thought.co.uk
TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXY_HOPS=1

# AI image-to-jigsaw inference
AI_ENABLED=0
AI_API_KEY=
AI_ENDPOINT_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_DAILY_BUDGET_USD=5.00
BULK_AI_CREATE_INLINE=0

# Image embeddings + visual match suggestions
IMAGE_EMBEDDINGS_ENABLED=0
