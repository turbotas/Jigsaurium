# Core runtime identity
APP_ENV=prod
FLASK_ENV=production
LOG_LEVEL=WARNING
SECRET_KEY=change-me-prod
# Optional runtime display overrides (leave commented to use image build metadata)
# APP_VERSION=v0.1.0
# APP_BUILD_SHA=<git-sha>
# APP_BUILD_TIME=2026-10-21T12:34:56Z

# Database + migration startup
DATABASE_URL=mysql+pymysql://user:password@db-host:3306/jigsaurium_prod
AUTO_MIGRATE=1
MAX_CONTENT_LENGTH_BYTES=33554432
SESSION_IDLE_TIMEOUT_MINUTES=120

# Host/proxy policy
CANONICAL_HOST=www.jigsaurium.lateral-thought.co.uk
CANONICAL_HOST_ENFORCEMENT=strict
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=1
HSTS_PRELOAD=0
TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXY_HOPS=1
TRUSTED_CLIENT_CIDRS=192.168.51.0/24

# In-app database backups
DB_BACKUP_STORAGE_PATH=
DB_BACKUP_COMPRESSION=gzip
DB_BACKUP_BLOB_CHUNK_BYTES=32768
DB_BACKUP_MAX_STATEMENT_BYTES=4194304

# AI image-to-jigsaw inference
AI_ENABLED=0
AI_API_KEY=
AI_ENDPOINT_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_DAILY_BUDGET_USD=5.00
BULK_AI_CREATE_INLINE=0

# Image embeddings + visual match suggestions
IMAGE_EMBEDDINGS_ENABLED=0
IMAGE_EMBEDDING_MODEL_NAME=openai/clip-vit-base-patch32
IMAGE_EMBEDDING_MODEL_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
IMAGE_EMBEDDING_MODEL_LOCAL_PATH=/opt/models/clip-vit-base-patch32
IMAGE_EMBEDDINGS_LOCAL_FILES_ONLY=1
IMAGE_EMBEDDINGS_WARM_ON_STARTUP=1
IMAGE_EMBEDDINGS_STARTUP_FAIL_ON_ERROR=1
IMAGE_EMBEDDINGS_INLINE=0
IMAGE_EMBEDDINGS_ALLOW_TEST_FALLBACK=0
IMAGE_EMBEDDING_REFERENCE_TAG_PREFIXES=box,reference
HF_TOKEN=

# STFD authentication (JWT assertion)
STFD_ENABLED=0
STFD_ALLOW_LOCAL_LOGIN=0
STFD_APP_UNI=
STFD_SHARED_KEY=
STFD_ASSERT_BASE_URL=
STFD_REDIRECT_URI=
STFD_ROLE_UNI_ADMINISTRATOR=
STFD_ROLE_UNI_BORROWER=
STFD_ROLE_UNI_MEMBER=
