# Environment for the container in the image smoke test (docker run --env-file). See settings.env.
# The workflow itself sets APP_ENV=test and a random SECRET_KEY. The throwaway MariaDB is on
# 127.0.0.1:3306 with database, user and password: app / app / ci-smoke-password.
DATABASE_URL=mysql+pymysql://app:ci-smoke-password@127.0.0.1:3306/app
AUTO_MIGRATE=1
SESSION_IDLE_TIMEOUT_MINUTES=120
CANONICAL_HOST=www.example.test
CANONICAL_HOST_ENFORCEMENT=strict
IMAGE_EMBEDDINGS_ENABLED=1
