# Settings for this app, read by the workflows in .github/workflows.
#
# The workflow files are shared: they are kept identical across apps, and Jigsaurium holds the
# reference copy. Fix a workflow problem in Jigsaurium first, then copy the workflow files to the
# other apps unchanged. Anything that must differ between apps belongs in this folder, not in a
# workflow file:
#   settings.env  this file: how the workflows build, test and promote this app
#   test.env      extra environment for the pytest jobs
#   smoke.env     environment for the container in the image smoke test (docker --env-file)
# The image and package name are not set here: they are the repository name in lower case.
#
# One KEY=value per line, no quotes. Lines starting with # are ignored.

# Python for the test jobs and the lock-file refresh. Keep in line with the Dockerfile's base image.
CI_PYTHON_VERSION=3.12

# What the test jobs install: pip install -r CI_TEST_REQUIREMENTS -c CI_TEST_LOCK
CI_TEST_REQUIREMENTS=requirements/dev.txt
CI_TEST_LOCK=requirements/known-good-dev.txt

# Profiles the weekly refresh passes to scripts/update_python_dependencies.py --profile.
CI_LOCK_PROFILES=prod dev

# Image smoke test: the port the container listens on, its health URL path, and the Host header
# for the home-page request (empty: no Host header).
CI_APP_PORT=5000
CI_HEALTH_PATH=/api/v1/health
CI_HOME_HOST=www.example.test

# Image smoke test: paths under /app that must not be in the image, and paths that must be (a path
# starting with / is checked as it is). CI_IMAGE_RUN_AS_UID: the user ID the app must run as
# (empty: not checked).
CI_IMAGE_MUST_NOT_CONTAIN=.git .github .env tests Documentation ijfw .ijfw deploy environments node_modules instance README.md run.bat
CI_IMAGE_MUST_CONTAIN=app/templates/home.html app/static/js/app.js migrations alembic.ini scripts/docker_entrypoint.sh scripts/regenerate_image_derivatives.py
CI_IMAGE_RUN_AS_UID=

# true: the app has image recognition, so the weekly Embedding Runtime Tests run. false: they are skipped.
CI_IMAGE_RECOGNITION=true

# How prod is promoted after a master build:
#   approval  Build and Promote waits for approval on the `prod` environment (needs required reviewers)
#   manual    Build and Promote stops at test; run Promote Pointer Tag by hand for prod
CI_PROD_PROMOTION=approval

# true: the weekly dependency PR merges itself once the required checks pass (needs branch
# protection with required checks). false: merge it by hand.
CI_DEPS_AUTO_MERGE=true
